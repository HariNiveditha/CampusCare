# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local or hosted MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/complaint-redressal-system

# JWT Secret - Use a cryptographically secure random string in production
JWT_SECRET=your_jwt_secret_key_change_in_production

# JWT Expiration (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h
